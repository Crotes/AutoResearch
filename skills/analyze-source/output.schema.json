{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.local/skills/analyze-source/output.schema.json",
  "title": "analyze-source output",
  "allOf": [
    { "$ref": "https://autoresearch.local/skills/_shared/output-envelope.schema.json" },
    {
      "properties": {
        "skill": {
          "properties": {
            "name": { "const": "analyze-source" },
            "version": { "const": "1.0.0" }
          }
        },
        "evidence_ids": { "minItems": 1 },
        "structured": {
          "type": "object",
          "required": ["work_id", "research_problem", "method", "experiments", "results", "limitations", "applicability", "reproducibility", "relation_to_question"],
          "properties": {
            "work_id": { "type": "string", "minLength": 1 },
            "research_problem": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 },
            "experiments": { "type": "string", "minLength": 1 },
            "results": { "type": "string", "minLength": 1 },
            "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "applicability": { "type": "string", "minLength": 1 },
            "reproducibility": { "type": "string", "minLength": 1 },
            "relation_to_question": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
