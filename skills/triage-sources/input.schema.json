{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.local/skills/triage-sources/input.schema.json",
  "title": "triage-sources input",
  "type": "object",
  "required": ["question", "candidates"],
  "properties": {
    "question": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["work_id", "source_version_id", "title", "canonical_url", "kind"],
        "properties": {
          "work_id": { "type": "string", "minLength": 1 },
          "source_version_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "canonical_url": { "type": "string", "format": "uri" },
          "kind": { "enum": ["arxiv", "github", "rss", "manual_url"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
