{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.local/skills/triage-sources/output.schema.json",
  "title": "triage-sources output",
  "allOf": [
    { "$ref": "https://autoresearch.local/skills/_shared/output-envelope.schema.json" },
    {
      "properties": {
        "skill": {
          "properties": {
            "name": { "const": "triage-sources" },
            "version": { "const": "1.0.0" }
          }
        },
        "evidence_ids": { "minItems": 1 },
        "structured": {
          "type": "object",
          "required": ["overviews", "review"],
          "properties": {
            "overviews": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["work_id", "title", "conclusion", "relation", "canonical_url", "tags", "scores", "recommendation"],
                "properties": {
                  "work_id": { "type": "string", "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "conclusion": { "type": "string", "minLength": 1 },
                  "relation": { "type": "string", "minLength": 1 },
                  "canonical_url": { "type": "string", "format": "uri" },
                  "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                  "scores": {
                    "type": "object",
                    "required": ["relevance", "credibility", "evidence_strength", "novelty", "timeliness", "reproducibility", "potential_value"],
                    "properties": {
                      "relevance": { "type": "integer", "minimum": 0, "maximum": 5 },
                      "credibility": { "type": "integer", "minimum": 0, "maximum": 5 },
                      "evidence_strength": { "type": "integer", "minimum": 0, "maximum": 5 },
                      "novelty": { "type": "integer", "minimum": 0, "maximum": 5 },
                      "timeliness": { "type": "integer", "minimum": 0, "maximum": 5 },
                      "reproducibility": { "type": "integer", "minimum": 0, "maximum": 5 },
                      "potential_value": { "type": "integer", "minimum": 0, "maximum": 5 }
                    },
                    "additionalProperties": false
                  },
                  "recommendation": { "enum": ["select", "hold", "exclude"] }
                },
                "additionalProperties": false
              }
            },
            "review": {
              "type": "object",
              "required": ["gate", "status"],
              "properties": {
                "gate": { "const": "source_selection" },
                "status": { "const": "pending" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
