{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.local/skills/plan-research/input.schema.json",
  "title": "plan-research input",
  "type": "object",
  "required": ["question", "include_terms", "languages", "source_kinds", "budget"],
  "properties": {
    "question": { "type": "string", "minLength": 1 },
    "include_terms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "exclude_terms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 },
      "uniqueItems": true
    },
    "source_kinds": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["arxiv", "github", "rss", "manual_url"] },
      "uniqueItems": true
    },
    "start_date": { "type": ["string", "null"], "format": "date" },
    "end_date": { "type": ["string", "null"], "format": "date" },
    "seed_urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "required": ["max_candidates", "max_queries"],
      "properties": {
        "max_candidates": { "type": "integer", "minimum": 1 },
        "max_queries": { "type": "integer", "minimum": 1, "maximum": 50 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
