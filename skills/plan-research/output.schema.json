{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.local/skills/plan-research/output.schema.json",
  "title": "plan-research output",
  "allOf": [
    { "$ref": "https://autoresearch.local/skills/_shared/output-envelope.schema.json" },
    {
      "properties": {
        "skill": {
          "properties": {
            "name": { "const": "plan-research" },
            "version": { "const": "1.0.0" }
          }
        },
        "structured": {
          "type": "object",
          "required": ["plan", "query_expansions", "review"],
          "properties": {
            "plan": {
              "type": "object",
              "required": ["question", "include_terms", "exclude_terms", "languages", "source_kinds", "max_candidates"],
              "properties": {
                "question": { "type": "string", "minLength": 1 },
                "include_terms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "exclude_terms": { "type": "array", "items": { "type": "string" } },
                "languages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "source_kinds": { "type": "array", "minItems": 1, "items": { "enum": ["arxiv", "github", "rss", "manual_url"] } },
                "max_candidates": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            },
            "query_expansions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["query", "language", "rationale"],
                "properties": {
                  "query": { "type": "string", "minLength": 1 },
                  "language": { "type": "string", "minLength": 2 },
                  "rationale": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "review": {
              "type": "object",
              "required": ["gate", "status"],
              "properties": {
                "gate": { "const": "plan_confirmation" },
                "status": { "const": "pending" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
