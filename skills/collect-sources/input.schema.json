{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.local/skills/collect-sources/input.schema.json",
  "title": "collect-sources input",
  "type": "object",
  "required": ["plan", "queries", "plan_review", "max_candidates"],
  "properties": {
    "plan": {
      "type": "object",
      "required": ["question", "source_kinds"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "source_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["arxiv", "github", "rss", "manual_url"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "plan_review": {
      "type": "object",
      "required": ["gate", "status"],
      "properties": {
        "gate": { "const": "plan_confirmation" },
        "status": { "const": "approved" }
      },
      "additionalProperties": false
    },
    "max_candidates": { "type": "integer", "minimum": 1, "maximum": 100 }
  },
  "additionalProperties": false
}
